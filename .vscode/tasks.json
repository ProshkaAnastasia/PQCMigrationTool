{
  "version": "2.0.0",
  "tasks": [
    { "label": "CMake: Configure", "type": "shell",
      "command": "cmake", "args": ["-S","${workspaceFolder}","-B","${workspaceFolder}/build","-DCMAKE_BUILD_TYPE=Debug","-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"],
      "group": "build", "problemMatcher": [] },
    { "label": "CMake: Build All", "type": "shell",
      "command": "cmake", "args": ["--build","${workspaceFolder}/build","--parallel"],
      "group": {"kind":"build","isDefault":true}, "dependsOn": "CMake: Configure", "problemMatcher": "$gcc" },
    { "label": "Run: scan samples", "type": "shell",
      "command": "${workspaceFolder}/build/bin/pqc_scanner",
      "args": ["--path","${workspaceFolder}/data/samples","--out","${workspaceFolder}/reports/samples.json","--verbose"],
      "options": {"cwd":"${workspaceFolder}"}, "dependsOn": "CMake: Build All" },
    { "label": "Run: scan project", "type": "shell",
      "command": "${workspaceFolder}/build/bin/pqc_scanner",
      "args": ["--path","${workspaceFolder}","--out","${workspaceFolder}/reports/self_report.json"],
      "options": {"cwd":"${workspaceFolder}"}, "dependsOn": "CMake: Build All" },
    { "label": "Run: tests", "type": "shell",
      "command": "${workspaceFolder}/build/bin/pqc_tests",
      "options": {"cwd":"${workspaceFolder}"}, "dependsOn": "CMake: Build All" },
    { "label": "CMake: Clean", "type": "shell", "command": "rm -rf ${workspaceFolder}/build", "group": "build", "problemMatcher": [] }
  ]
}